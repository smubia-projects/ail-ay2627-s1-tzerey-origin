# =============================================================================
# Origin API (server/server.js): environment variables
#
# Copy to `.env` (git-ignored) and fill in. For Cloud Run, the whole file is uploaded
# as the repo's DOTENV secret:  gh secret set DOTENV --repo smubia-projects/ail-ay2627-s1-tzerey-origin < .env
# Keys are read only by the API server and are never sent to the browser.
#
# Research dossiers are ALWAYS synthetic (server/mock.js); the only AI call is the
# email draft on POST /api/email-draft.
# =============================================================================

# --- Language model (OpenRouter) ---------------------------------------------
# https://openrouter.ai/keys . Required for live email drafts.
API_KEY=
# Model used to draft emails (any OpenRouter model id).
MODEL_NAME=gemini-3.5-flash-lite

# --- CORS ----------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API (the Vercel URL in production).
# Default when unset: http://localhost:5500,http://127.0.0.1:5500 (local static server)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Rate limiting (shared AI Lodge engine, Upstash Redis) -------------------
# Without these, rate limiting is disabled (fine for local development only).
# The short names UPSTASH_REDIS_URL / UPSTASH_REDIS_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Fallback limits (the central rate-limit sheet overrides them at runtime).
# Email drafts per visitor IP per window (bucket "email").
RATE_LIMIT_EMAIL_MAX=5
# Window in seconds (432000 = 5 days).
RATE_LIMIT_WINDOW_SECONDS=432000

# --- Demo behaviour (optional) -------------------------------------------------
# Speed of the synthetic research animation: 1 = about 10 s, 0.5 = about 5 s.
OUTREACH_MOCK_SPEED=0.5
# Local development only: 1 = keyless demo email drafts as well (same as npm run start:mock).
# OUTREACH_MOCK=1
# Skip the synthetic research delays entirely (tests).
# OUTREACH_MOCK_FAST=1

# --- Server (optional) -----------------------------------------------------------
# Cloud Run sets PORT itself (8080). HOST defaults to 0.0.0.0.
# PORT=8080
# HOST=0.0.0.0
