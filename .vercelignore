# Files that must never be uploaded to Vercel when deploying with the CLI (git-based deploys use .gitignore).
# Keep tools/: the build script needs it. The API runs on Cloud Run, so server/ is not needed on Vercel.
private/
.env
.env.*
!.env.example
logs/
tests/
public/
node_modules/
.git/
*.pdf
*-dossier.json
